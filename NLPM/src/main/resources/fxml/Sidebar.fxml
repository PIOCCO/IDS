<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.SidebarController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="sidebar-scroll"
            style="-fx-background: #1a1a1a; -fx-border-color: transparent;">

    <VBox fx:id="sidebarRoot"
          styleClass="sidebar"
          spacing="5"
          prefWidth="220.0">

    <padding>
        <Insets top="20" right="15" bottom="20" left="15"/>
    </padding>

    <!-- Logo/Title -->
    <VBox styleClass="sidebar-header" spacing="5">
        <Label text="🛡 IDS Monitor" styleClass="sidebar-title"/>
        <Label text="Intrusion Detection System" styleClass="sidebar-subtitle"/>
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>
    </VBox>

    <!-- Current User Info -->
    <VBox spacing="5" style="-fx-background-color: #2a2a2a; -fx-padding: 10; -fx-background-radius: 8;">
        <Label fx:id="currentUserLabel"
               text="👤 Admin"
               style="-fx-text-fill: #4CAF50; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label fx:id="userRoleLabel"
               text="Administrator"
               style="-fx-text-fill: #b0b0b0; -fx-font-size: 14px;"/>
        <Label text="Logged In"
               style="-fx-text-fill: #808080; -fx-font-size: 10px;"/>
        
        <!-- User Account Buttons -->
        <Button fx:id="personalInfoBtn"
                text="👤 Personal Info"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px;
                       -fx-padding: 6 12; -fx-cursor: hand; -fx-background-radius: 5;">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
        <Button fx:id="logoutBtn"
                text="🚪 Logout"
                onAction="#handleLogout"
                style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-size: 13px;
                       -fx-padding: 6 12; -fx-cursor: hand; -fx-background-radius: 5;">
            <VBox.margin>
                <Insets top="2"/>
            </VBox.margin>
        </Button>
        <VBox.margin>
            <Insets bottom="15"/>
        </VBox.margin>
    </VBox>

    <!-- Navigation Buttons -->
    <Label text="NAVIGATION" styleClass="sidebar-section-title">
        <VBox.margin>
            <Insets top="10" bottom="10"/>
        </VBox.margin>
    </Label>

    <Button fx:id="dashboardBtn" text="📊 Dashboard" styleClass="sidebar-button"/>
    <Button fx:id="alertsBtn" text="🚨 Alerts" styleClass="sidebar-button"/>
    <Button fx:id="trafficBtn" text="🌐 Traffic Monitor" styleClass="sidebar-button"/>
    <Button fx:id="reportsBtn" text="📄 Reports" styleClass="sidebar-button"/>

    <!-- Testing Section -->
    <Label text="TESTING" styleClass="sidebar-section-title">
        <VBox.margin>
            <Insets top="30" bottom="10"/>
        </VBox.margin>
    </Label>

    <Button fx:id="threatSimulatorBtn"
            text="🚨 Threat Simulator"
            styleClass="sidebar-button"
            style="-fx-border-color: #FF9800; -fx-border-width: 0 0 0 3;"/>

    <!-- Admin Section - Hidden for non-admin users -->
    <VBox fx:id="adminSection" spacing="5">
        <Label text="ADMINISTRATION" styleClass="sidebar-section-title">
            <VBox.margin>
                <Insets top="30" bottom="10"/>
            </VBox.margin>
        </Label>

        <Button fx:id="createUserBtn"
                text="👥 User Management"
                styleClass="sidebar-button"
                style="-fx-border-color: #FFD700; -fx-border-width: 0 0 0 3;"/>
    </VBox>

    <!-- Configuration Section -->
    <Label text="CONFIGURATION" styleClass="sidebar-section-title">
        <VBox.margin>
            <Insets top="30" bottom="10"/>
        </VBox.margin>
    </Label>

    <Button fx:id="rulesBtn" text="⚙️ Rules" styleClass="sidebar-button"/>
    <Button fx:id="settingsBtn" text="🔧 Settings" styleClass="sidebar-button"/>

    <!-- Separator removed - Logout is now in user section -->

    <!-- System Status at Bottom -->
    <VBox styleClass="system-status" spacing="8" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
        <Label text="System Status" styleClass="status-title"/>
        <Label text="● Active" styleClass="status-active"/>
        <Label text="Version 1.0.0"
               style="-fx-text-fill: #808080; -fx-font-size: 10px;"/>
    </VBox>

    </VBox>
</ScrollPane>