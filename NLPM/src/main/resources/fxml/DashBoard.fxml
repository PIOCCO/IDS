<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.DashboardController"
            fitToWidth="true"
            styleClass="content-scroll">

<VBox styleClass="content-view" spacing="20">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- ============================================================
         HEADER (Preserved)
         ============================================================ -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="15">
        <Label text="Dashboard" styleClass="page-title"/>
        <Label text="Real-time system overview" styleClass="page-subtitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshBtn" text="🔄 Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
    </HBox>

    <!-- ============================================================
         STATS CARDS (Preserved)
         ============================================================ -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="0">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label text="Total Alerts" styleClass="stat-label"/>
            <Label fx:id="totalAlertsLabel" text="0" styleClass="stat-value"/>
            <Label text="All time" styleClass="stat-change info"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="1">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label text="Critical Alerts" styleClass="stat-label"/>
            <Label fx:id="criticalAlertsLabel" text="0" styleClass="stat-value"/>
            <Label text="Requires attention" styleClass="stat-change critical"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="2">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label text="Warnings" styleClass="stat-label"/>
            <Label fx:id="warningAlertsLabel" text="0" styleClass="stat-value"/>
            <Label text="Monitor closely" styleClass="stat-change warning"/>
        </VBox>

        <VBox styleClass="stat-card" spacing="8" GridPane.columnIndex="3">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label text="Packets Analyzed" styleClass="stat-label"/>
            <Label fx:id="packetsAnalyzedLabel" text="0" styleClass="stat-value"/>
            <Label text="Last 24 hours" styleClass="stat-change info"/>
        </VBox>
    </GridPane>

    <!-- ============================================================
         COCKPIT CHART SECTION (Integrated, Reduced Height)
         ============================================================ -->
    <VBox styleClass="cockpit-section" spacing="0">
        
        <!-- Chart Header Bar -->
        <HBox styleClass="cockpit-header" alignment="CENTER_LEFT" spacing="15">
            <Label text="📊 Network Metrics" styleClass="cockpit-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Time:" styleClass="control-label-mini"/>
            <ComboBox fx:id="timeRangeSelector" styleClass="time-selector-compact" prefWidth="120"/>
            <Button text="⟳" styleClass="btn-mini-refresh" onAction="#handleChartRefresh"/>
        </HBox>
        
        <!-- Chart Area (REDUCED HEIGHT) -->
        <VBox styleClass="cockpit-chart-area" minHeight="280" maxHeight="320">
            <AreaChart fx:id="metricsChart" 
                       styleClass="cockpit-chart"
                       VBox.vgrow="ALWAYS"
                       animated="false"
                       legendVisible="false"
                       createSymbols="false">
                <xAxis>
                    <CategoryAxis fx:id="chartXAxis" side="BOTTOM"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="chartYAxis" side="LEFT"/>
                </yAxis>
            </AreaChart>
        </VBox>
        
        <!-- Dock: Category Tabs (Full Width, Spaced) -->
        <HBox styleClass="dock-tabs" alignment="CENTER_LEFT" spacing="0">
            <ToggleButton fx:id="tabProtocol" text="PROTOCOL" styleClass="dock-tab, tab-protocol"/>
            <ToggleButton fx:id="tabAlert" text="ALERT" styleClass="dock-tab, tab-alert"/>
            <ToggleButton fx:id="tabSession" text="SESSION" styleClass="dock-tab, tab-session"/>
            <ToggleButton fx:id="tabTraffic" text="TRAFFIC" styleClass="dock-tab, tab-traffic"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="enabledMetricsLabel" text="0 active" styleClass="metrics-count"/>
        </HBox>
        
        <!-- Dock: Chips Zone (Full Width, Well Spaced) -->
        <HBox styleClass="dock-chips-zone">
            <FlowPane fx:id="chipsContainer" styleClass="chips-container" hgap="12" vgap="10" alignment="CENTER_LEFT"/>
        </HBox>
        
    </VBox>

    <!-- ============================================================
         RECENT ALERTS TABLE (Preserved)
         ============================================================ -->
    <VBox styleClass="table-container" VBox.vgrow="SOMETIMES" minHeight="180">
        <HBox styleClass="table-header" alignment="CENTER_LEFT">
            <Label text="Recent Alerts" styleClass="table-title"/>
        </HBox>

        <TableView fx:id="recentAlertsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="severityColumn" text="Severity" prefWidth="100"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="150"/>
                <TableColumn fx:id="sourceColumn" text="Source IP" prefWidth="150"/>
                <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
</ScrollPane>
